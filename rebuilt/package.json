{
  "name": "rebuilt-sim-murid",
  "version": "0.30.0",
  "description": "Sistem Informasi Murid MTs Nurul Falah",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:foundation": "node --experimental-strip-types --test tests/foundation.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test:foundation && npm run test:database && npm run test:auth && npm run test:login && npm run test:sessions && npm run test:authorization && npm run test:security && npm run test:recovery && npm run test:recovery:routes && npm run test:email && npm run test:settings && npm run test:education && npm run test:directory && npm run test:users && npm run test:operations && npm run test:learning && npm run test:services && npm run test:notifications && npm run test:ui && npm run test:dashboard && npm run test:production && npm run db:types:check && npm run build",
    "test:smoke": "node scripts/smoke.mjs",
    "db:types": "node scripts/database/generate-types.mjs",
    "db:types:check": "node scripts/database/generate-types.mjs --check",
    "test:database": "node --test tests/database/foundation.test.mjs",
    "db:advisory": "node scripts/database/advisory.mjs",
    "test:auth": "node --experimental-strip-types --test tests/auth.test.ts && node --test tests/database/auth.test.mjs",
    "test:sessions": "node --test tests/database/sessions.test.mjs",
    "test:authorization": "node --test tests/database/authorization.test.mjs",
    "test:security": "node --experimental-strip-types --test tests/security.test.ts && node --test tests/database/security.test.mjs",
    "test:recovery": "node --experimental-strip-types --test tests/recovery.test.ts && node --test tests/database/recovery.test.mjs",
    "test:email": "node --experimental-strip-types --test tests/email.test.ts && node --test tests/database/email.test.mjs",
    "test:settings": "node --experimental-strip-types --test tests/settings.test.ts && node --test tests/database/settings.test.mjs",
    "test:education": "node --experimental-strip-types --test tests/education.test.ts && node --test tests/database/education.test.mjs",
    "test:operations": "node --experimental-strip-types --test tests/operations.test.ts && node --test tests/database/operations.test.mjs",
    "prebuild": "node scripts/prepare-pdf-worker.mjs",
    "test:learning": "node --experimental-strip-types --test tests/learning.test.ts && node --test tests/database/learning.test.mjs",
    "test:services": "node --experimental-strip-types --test tests/services.test.ts && node --test tests/database/services.test.mjs",
    "test:ui": "node --experimental-strip-types --test tests/ui.test.ts",
    "test:ui:browser": "node scripts/verify-ui.mjs",
    "test:production": "node --test tests/production.test.mjs",
    "audit:deadcode": "node scripts/audit-deadcode.mjs",
    "test:dashboard": "node --test tests/dashboard.test.mjs",
    "test:dashboard:browser": "node scripts/verify-dashboard.mjs",
    "test:notifications:browser": "node scripts/verify-notifications.mjs",
    "test:notifications": "node --test tests/notifications-page.test.mjs",
    "test:directory": "node --experimental-strip-types --test tests/directory.test.ts && node --test tests/directory-server.test.mjs",
    "test:directory:browser": "node scripts/verify-directory.mjs",
    "test:users": "node --experimental-strip-types --test tests/users.test.ts && node --test tests/database/users.test.mjs && node --test tests/users-route.test.mjs",
    "test:users:browser": "node scripts/verify-users.mjs",
    "test:home:browser": "node scripts/verify-home.mjs",
    "test:login": "node --test tests/login-route.test.mjs tests/login-page.test.mjs",
    "test:login:browser": "node scripts/verify-login.mjs",
    "test:recovery:routes": "node --test tests/recovery-routes.test.mjs",
    "test:recovery:browser": "node scripts/verify-recovery.mjs"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.31",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
