{
  "name": "rebuilt-sim-murid",
  "version": "0.8.0",
  "description": "Keamanan akun dan onboarding Rebuilt SiM-Murid — Tahap 8",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:foundation": "node --experimental-strip-types --test tests/foundation.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test:foundation && npm run test:database && npm run test:auth && npm run test:sessions && npm run test:authorization && npm run test:security && npm run db:types:check && npm run build",
    "test:smoke": "node scripts/smoke.mjs",
    "db:types": "node scripts/database/generate-types.mjs",
    "db:types:check": "node scripts/database/generate-types.mjs --check",
    "test:database": "node --test tests/database/foundation.test.mjs",
    "db:advisory": "node scripts/database/advisory.mjs",
    "test:auth": "node --experimental-strip-types --test tests/auth.test.ts && node --test tests/database/auth.test.mjs",
    "test:sessions": "node --test tests/database/sessions.test.mjs",
    "test:authorization": "node --test tests/database/authorization.test.mjs",
    "test:security": "node --experimental-strip-types --test tests/security.test.ts && node --test tests/database/security.test.mjs"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.31",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  }
}
