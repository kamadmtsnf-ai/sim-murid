# Dedicated SiM-Murid project only. Never commit actual values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret. Required for username adapter and private session RPCs.
SUPABASE_SECRET_KEY=

# Gmail SMTP transactional email; all server-only.
GMAIL_APP_PASSWORD=
GMAIL_USER=
GMAIL_SENDER_NAME=
EMAIL_OTP_SECRET=

# Optional server integrations; never NEXT_PUBLIC or committed actual values.
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
CRON_SECRET=
SERVICES_DISPATCH_ENABLED=false

# WP-01 Web Push contract. All activation flags fail closed; sender is not wired yet.
# Keep Preview and Production key material independent. Never commit real values.
WEB_PUSH_ENABLED=false
WEB_PUSH_DISPATCH_ENABLED=false
WEB_PUSH_TEST_ENABLED=false
WEB_PUSH_CATEGORY_POINTS_ENABLED=false
WEB_PUSH_CATEGORY_SCHEDULE_ENABLED=false
WEB_PUSH_CATEGORY_REPORTS_ENABLED=false
WEB_PUSH_CATEGORY_SURVEYS_ENABLED=false
WEB_PUSH_CATEGORY_FOLLOW_UP_ENABLED=false
WEB_PUSH_CATEGORY_DOCUMENTS_ENABLED=false
WEB_PUSH_ENVIRONMENT=development
WEB_PUSH_APP_ORIGIN=
WEB_PUSH_STAGING_SUPABASE_REF=
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_VAPID_KEY_VERSION=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_ENCRYPTION_KEY_VERSION=
WEB_PUSH_ENCRYPTION_KEY=
# WP-05: 43..128 URL-safe characters, dedicated to POST /api/push/worker.
# Matching value goes to private Vault sim_murid_push_worker_secret; never CRON_SECRET.
WEB_PUSH_WORKER_SECRET=

# P12: leave disabled until private quota migration, privacy and provider budget are approved.
AI_ANALYSIS_ENABLED=false
# Required for activation: integer 1..20, global reservations per WIB calendar day.
AI_DAILY_REQUEST_LIMIT=1
# Comma-separated provider:model pairs selected by the operator; no implicit model default.
AI_ALLOWED_MODELS=

# Google reCAPTCHA v2 Checkbox. Configure keys/domains first, then activate and redeploy.
# Site key is public (passed by the server to LoginForm); secret must stay server-only.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Exact hostnames, without scheme, path, port or wildcard; comma separated.
RECAPTCHA_ALLOWED_HOSTNAMES=sim-muridv2.vercel.app
