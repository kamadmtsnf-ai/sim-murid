# Dedicated SiM-Murid project only. Never commit actual values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret. Required for username adapter and private session RPCs.
SUPABASE_SECRET_KEY=

# Gmail SMTP transactional email; all server-only.
GMAIL_APP_PASSWORD=
GMAIL_USER=
GMAIL_SENDER_NAME=
EMAIL_OTP_SECRET=

# Optional server integrations; never NEXT_PUBLIC or committed actual values.
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
CRON_SECRET=
SERVICES_DISPATCH_ENABLED=false

# P12: leave disabled until private quota migration, privacy and provider budget are approved.
AI_ANALYSIS_ENABLED=false
# Required for activation: integer 1..20, global reservations per WIB calendar day.
AI_DAILY_REQUEST_LIMIT=1
# Comma-separated provider:model pairs selected by the operator; no implicit model default.
AI_ALLOWED_MODELS=
